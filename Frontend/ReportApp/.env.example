# Để trống nếu ReportApp được Express serve cùng origin tại /report (mặc định — xem Backend/server.js).
# Chỉ điền URL tuyệt đối nếu deploy ReportApp riêng (VD Vercel project khác domain Backend).
VITE_API_URL=

# App ID Zalo của An Hải — PHẢI đã bật quyền "Đăng nhập Zalo" trên Zalo Developers Console,
# và khai báo Redirect URI = <domain>/report (trùng ZALO_APP_ID trong Backend/.env).
VITE_ZALO_APP_ID=
